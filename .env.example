APP_NAME="Management Operating System"
APP_ENV=local
APP_KEY=
# ponytail: default false — never expose stack traces to users on a fresh deploy
# that forgot to override APP_DEBUG. Devs must explicitly set APP_DEBUG=true.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# ponytail: default to daily + stderr so prod containers stream logs and rotate files.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ponytail: production error reporting — set in production to receive email
# alerts for warning+ level log entries. Leave empty in local/dev.
ERROR_REPORTING_EMAIL=

# ponytail: optional Sentry integration. Uncomment + set DSN in production
# for richer error tracking (stack traces, release tracking, user context).
# Install the SDK first: composer require sentry/sentry-laravel
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ponytail: spatie/laravel-backup — defaults to local disk. Override to s3
# in production after configuring the s3 disk in config/filesystems.php.
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=4
BACKUP_DELETE_OLDEST_MB=5000

# ponytail: spatie/activitylog — enable/disable audit logging globally.
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_DELETE_DAYS=90

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# ponytail: encrypt active_team_id/active_organization_id so a DB dump cannot
# be trivially used to forge tenant context.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# ponytail: set to true in production behind HTTPS.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
